# Copy to admin/.env (gitignored). Read only by the local admin server — never bundled into
# the UI and never deployed. Keep this file on your machine only.

# Supabase dashboard → Project Settings → API Keys
SUPABASE_URL=https://your-project.supabase.co
# the service_role / secret key — full write access, so it lives ONLY here
SUPABASE_SERVICE_ROLE_KEY=

# your deployed site + the same REVALIDATE_SECRET you set in Vercel, so publishing updates the site instantly
SITE_URL=https://your-site.vercel.app
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# optional, defaults to 4317 (the desktop app expects 4317)
# ADMIN_PORT=4317
